# PostgreSQL Connection String (Format: postgres://user:password@host:port/dbname?sslmode=disable)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bioarc?sslmode=disable

# MQTT Broker Settings
MQTT_BROKER=tcps://mqtt.mindzed.tech:8883
MQTT_CLIENT_ID=bioarc-go-backend
MQTT_USER=admin
MQTT_PASSWORD=secret

# REST API Port
PORT=8080
